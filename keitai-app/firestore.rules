rules_version = '2';
// ケータイ見積もり — Firestore セキュリティルール
//
// 現在の同期は「1つのFirebaseプロジェクト＝1店舗」を前提にしています。
// プロジェクトを店舗ごとに用意し、下記のとおりドメインを絞ってください。
//
// 反映方法: Firebaseコンソール → Firestore Database → ルール にこの内容を貼り付けて公開
service cloud.firestore {
  match /databases/{database}/documents {
    // 見積もり（担当A/B/C）と料金マスタ
    match /settings/{docId} {
      allow read, write: if docId.matches('keitaiQuote.*');
    }
    // それ以外は一切許可しない
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
