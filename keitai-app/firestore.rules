rules_version = '2';
// ケータイ見積もり — Firestore セキュリティルール
//
// 店舗アカウントでログインしている場合のみ、その店舗自身のデータへアクセスできます。
// 他店のデータは読むことも書くこともできません。
//
// 反映方法: Firebaseコンソール → Firestore Database → ルール にこの内容を貼り付けて公開
service cloud.firestore {
  match /databases/{database}/documents {
    // stores/{店舗のUID} と、その配下の見積もり（quotes/{担当者ID}）
    match /stores/{storeId} {
      allow read, write: if request.auth != null && request.auth.uid == storeId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == storeId;
      }
    }
    // それ以外は一切許可しない
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
