rules_version = '2';
// フロントーク（料金見積もりシミュレーション） — Firestore セキュリティルール
//
// 店舗アカウントでログインしている場合のみ、その店舗自身のデータへアクセスできます。
// 他店のデータは読むことも書くこともできません。
// あわせて、書き込みの形（フィールド名）と大きさを検査し、
// 不具合や不正なクライアントによる想定外の書き込みを弾きます。
//
// 反映方法: Firebaseコンソール → Firestore Database → ルール にこの内容を貼り付けて公開
service cloud.firestore {
  match /databases/{database}/documents {
    // 共通: 書き込みサイズの上限（1ドキュメントの実効上限1MiBの少し手前で止める）
    /* 保守用（開発者専用）アカウント。下の DEV_UID_HERE を、
     * Authentication 上の保守アカウントのユーザーUIDに置き換えて公開すると、
     * そのアカウントだけ全店舗のデータを読み書きできます（サポート・修理用）。
     * 置き換えずに公開しても、誰にも一致しないので何も起きません。 */
    function isDev() {
      return request.auth != null && request.auth.uid == 'M4MFfPd80oTBN3RdqH0Z3WsLHyY2';
    }
    function sizeOk() {
      return request.resource.size() < 900000;
    }
    function stamped() {
      // アプリが必ず付ける印。付いていない書き込みはアプリ外からの可能性が高い
      return request.resource.data.keys().hasAll(['clientId']);
    }
    /* 契約の器: contracts/{店舗UID} に販売側がコンソールから入れる契約状態。
     *   status: "trial"（trialEndsAt まで）/ "active"（本契約）/ "suspended"（停止）
     * ドキュメントが無い店舗は従来どおり（既存店舗を壊さない）。
     * お試し終了・停止の店舗は、読み取りはできるが書き込みはできない
     * （データは消えず、契約手続き後にそのまま使える）。 */
    function contractData() {
      return get(/databases/$(database)/documents/contracts/$(request.auth.uid)).data;
    }
    function contractOk() {
      return !exists(/databases/$(database)/documents/contracts/$(request.auth.uid))
        || contractData().status == 'active'
        || (contractData().status == 'trial'
            && (!('trialEndsAt' in contractData())
                || request.time < contractData().trialEndsAt));
    }
    /* 上位アカウント（代理店・エリア）。roles/{アカウントUID} に販売側が
     * コンソールから { type: "agency"|"area", org: "札", area: "札" } を書くと、
     * そのアカウントは「契約の器（contracts）の org（エリアは area も）が一致する
     * 店舗」だけを読み書きできます。所属の札は contracts にあり、contracts は
     * アプリから書き込めないため、店舗が自分の所属を書き換えて他店を覗くことは
     * できません。roles が無い普通の店舗アカウントには何も起きません。 */
    function roleData() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }
    function hasRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }
    function storeContract(storeId) {
      return get(/databases/$(database)/documents/contracts/$(storeId)).data;
    }
    function roleCanSee(storeId) {
      return hasRole()
        && exists(/databases/$(database)/documents/contracts/$(storeId))
        && ('org' in storeContract(storeId))
        && storeContract(storeId).org == roleData().org
        && (roleData().type == 'agency'
            || (('area' in storeContract(storeId))
                && storeContract(storeId).area == roleData().area));
    }
    /* 上位アカウントの書き込みは、見ている店舗の契約が有効なときだけ。
     * contractOk() は「書き込む本人（＝上位アカウント自身）」の契約しか見ないため、
     * それだけだと停止・お試し切れの店舗へも上位経由で書けてしまう。
     * 読み取りは従来どおり（停止店舗も読める＝データは消えない）。 */
    function storeContractOk(storeId) {
      return storeContract(storeId).status == 'active'
        || (storeContract(storeId).status == 'trial'
            && (!('trialEndsAt' in storeContract(storeId))
                || request.time < storeContract(storeId).trialEndsAt));
    }
    function roleCanWrite(storeId) {
      return roleCanSee(storeId) && storeContractOk(storeId);
    }

    // roles/{アカウントUID}: 上位アカウントの役割。本人が読めるだけ（書き込みは販売側のコンソール操作のみ）
    match /roles/{accountId} {
      allow read: if (request.auth != null && request.auth.uid == accountId) || isDev();
      allow write: if false;
    }

    // contracts/{店舗のUID}: 契約状態。店舗は自分のぶんを読めるだけ（書き込みは販売側のコンソール操作のみ）
    // 上位アカウントは、所属の札（org／area）が一致する店舗のぶんを読める（店舗一覧づくりに使う）
    match /contracts/{storeId} {
      allow read: if (request.auth != null && request.auth.uid == storeId) || isDev()
        || (hasRole()
            && ('org' in resource.data) && resource.data.org == roleData().org
            && (roleData().type == 'agency'
                || (('area' in resource.data) && resource.data.area == roleData().area)));
      allow write: if false;
    }

    // stores/{店舗のUID}: 店舗情報＋料金マスタ
    match /stores/{storeId} {
      allow read: if (request.auth != null && request.auth.uid == storeId) || isDev() || roleCanSee(storeId);
      allow write: if ((request.auth != null && request.auth.uid == storeId) || isDev() || roleCanWrite(storeId))
        && contractOk()
        && sizeOk()
        && request.resource.data.keys().hasOnly(
             ['storeName', 'storeTel', 'staff', 'adminLock', 'master',
              'clientId', 'updatedAtMs', 'updatedAt']);

      // quotes/{担当者ID}: 作業中の見積もり
      match /quotes/{staffId} {
        allow read: if (request.auth != null && request.auth.uid == storeId) || isDev() || roleCanSee(storeId);
        allow write: if ((request.auth != null && request.auth.uid == storeId) || isDev() || roleCanWrite(storeId))
          && contractOk()
          && sizeOk() && stamped()
          && request.resource.data.keys().hasOnly(['data', 'clientId', 'updatedAtMs', 'updatedAt']);
      }
      // saved/{担当者ID}: 保存した見積もり（del は削除の記録）
      match /saved/{staffId} {
        allow read: if (request.auth != null && request.auth.uid == storeId) || isDev() || roleCanSee(storeId);
        allow write: if ((request.auth != null && request.auth.uid == storeId) || isDev() || roleCanWrite(storeId))
          && contractOk()
          && sizeOk() && stamped()
          && request.resource.data.keys().hasOnly(['list', 'del', 'clientId', 'updatedAtMs', 'updatedAt']);
      }
      // templates/{担当者ID}: テンプレート（_store は店舗共通テンプレート）
      match /templates/{staffId} {
        allow read: if (request.auth != null && request.auth.uid == storeId) || isDev() || roleCanSee(storeId);
        allow write: if ((request.auth != null && request.auth.uid == storeId) || isDev() || roleCanWrite(storeId))
          && contractOk()
          && sizeOk() && stamped()
          && request.resource.data.keys().hasOnly(['list', 'clientId', 'updatedAtMs', 'updatedAt']);
      }
      // history/{履歴ID}: 料金マスタの履歴
      match /history/{histId} {
        allow read: if (request.auth != null && request.auth.uid == storeId) || isDev() || roleCanSee(storeId);
        allow write: if ((request.auth != null && request.auth.uid == storeId) || isDev() || roleCanWrite(storeId)) && contractOk() && sizeOk();
      }
      // 上記以外のサブコレクションは作らせない
      match /{other}/{doc} {
        allow read: if (request.auth != null && request.auth.uid == storeId) || isDev() || roleCanSee(storeId);
        allow write: if false;
      }
    }
    // それ以外は一切許可しない
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
